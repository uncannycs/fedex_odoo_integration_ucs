<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fdx_form_view_delivery_carrier" model="ir.ui.view">
        <field name="name">delivery.carrier.fdx.view</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position='before'>
                <page string="Configuration" name="fdx_configuration" invisible = "delivery_type != 'fdx_delivery'">
                    <group>
                        <group>
                            <field name="company_id" required="delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_shipping_service" required="delivery_type == 'fdx_delivery'"/>
			     <field name="fdx_smartpost_hub"/>
                            <field name="fdx_smartpost_indicia"/>
                            <field name="fdx_pickup_method" required="delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_default_package_type_id" required="delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_rate_request_type" required="delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_billing_type" required="delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_wt_uom" required="delivery_type == 'fdx_delivery'"/>
                        </group>
                        <group>
                            <field name="fdx_label_stock" required = "delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_label_format" required = "delivery_type == 'fdx_delivery'"/>
                            <field name="fdx_cod"/>
                            <field name="fdx_require_signature"/>
                            <field name="fdx_signature_type" invisible = "fdx_require_signature == False" required="fdx_require_signature == True"/>
                            <field name="fdx_insurance"/>
                            <field name="fdx_use_onerate"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
