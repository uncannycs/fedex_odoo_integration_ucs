<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_fdx_third_party" model="ir.ui.view">
        <field name="name">sale.order.fdx.thirdparty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="fdx_tp_billing"
                       readonly = "state in ('cancel','sale')"/>
                <field name="fdx_tp_account_number"
                       invisible ="fdx_tp_billing != True" required = "fdx_tp_billing != False" readonly ="state in ('cancel','sale')"/>
            </xpath>
        </field>
    </record>
</odoo>			
